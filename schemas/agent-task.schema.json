{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper2Simu specialist assignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assignment_id",
    "task_id",
    "case_id",
    "role",
    "stage",
    "spec_hash",
    "revision",
    "snapshot_hash",
    "evidence_refs",
    "question",
    "deadline_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-task/1"
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "role": {
      "enum": [
        "orchestrator",
        "paper_reader",
        "documentation_expert",
        "physics_reviewer",
        "executor",
        "supervisor",
        "recovery_agent",
        "acceptance_agent",
        "recorder",
        "experiment_designer"
      ]
    },
    "stage": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "deadline_utc": {
      "type": "string",
      "format": "date-time"
    }
  }
}
